      </div>

      <!-- Right Dark Metallic Angled Wing with RR-Style Royal Crest -->
      <div class="wing-shield-right">
        <div class="wing-inner-right">
          <div class="team-crest-box" id="rightCrestContainer">
            <svg width="52" height="50" viewBox="0 0 60 60" aria-label="Bowling Team Crest">
              <defs>
                <linearGradient id="rrGold" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#fef08a"/>
                  <stop offset="50%" stop-color="#facc15"/>
