              <path d="M16,19 L32,11 L48,19" fill="none" stroke="#38bdf8" stroke-width="2.2"/>
              <text x="32" y="34" text-anchor="middle" fill="#ffffff" font-family="Oswald, sans-serif" font-weight="700" font-size="13.5" letter-spacing="0.6" id="svgLeftText">TITANS</text>
