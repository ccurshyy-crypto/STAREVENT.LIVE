# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Realtime & Overlay Access Keys (public project URL & publishable anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Owner-only Admin Panel Passcode (server-side only; never prefix with VITE_)
ADMIN_PASSCODE=

# Supabase Admin API / Edge Function secrets (server-side ONLY; NEVER prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EDGE_FUNCTION_URL=
ADMIN_EDGE_SECRET=

# Optional Owner UPI details for dynamic WorldCup ₹99 QR code generation
VITE_OWNER_UPI_ID=
VITE_OWNER_UPI_NAME=
