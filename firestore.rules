rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Star Event Live — Hardened Per-User Isolated Kabaddi Scoreboard Rules
    // ===============================================================

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (
          request.auth.token.email == 'ccurshyy@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
        )
      );
    }

    function isValidLoginId(id) {
      return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[A-Z0-9]+$');
    }

    function isValidRoomId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-z0-9-]+$');
    }

    function isValidIsoTimestamp(ts) {
      return ts is string && ts.size() >= 10 && ts.size() <= 40;
    }

    function isOptionalBoundedInt(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || (data[field] is int && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalBoundedString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBoundedStringList(data, field, maxItems) {
      return !(field in data) || (
        data[field] is list &&
        data[field].size() <= maxItems &&
        (data[field].size() == 0 || (data[field][0] is string && data[field][0].size() <= 60))
      );
    }

    // Validation Blueprints
    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.uid is string && data.uid == adminUid && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role == 'super_admin' &&
        isValidIsoTimestamp(data.createdAt);
    }

    function isValidUserAccount(data, userUid) {
      return data.keys().hasAll([
          'uid',
          'fullName',
          'loginId',
          'authEmail',
          'role',
          'matchRoomId',
          'scoreboardUrl',
          'vmixOverlayUrl',
          'status',
          'passwordVersion',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'fullName',
          'loginId',
          'authEmail',
          'recoveryEmail',
          'role',
          'matchRoomId',
          'scoreboardUrl',
          'vmixOverlayUrl',
          'status',
          'passwordVersion',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userUid && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
        isValidLoginId(data.loginId) &&
        data.authEmail is string && data.authEmail.size() >= 5 && data.authEmail.size() <= 120 &&
        isOptionalBoundedString(data, 'recoveryEmail', 120) &&
        data.role == 'user' &&
        isValidRoomId(data.matchRoomId) &&
        data.scoreboardUrl is string && data.scoreboardUrl.size() >= 1 && data.scoreboardUrl.size() <= 300 &&
        data.vmixOverlayUrl is string && data.vmixOverlayUrl.size() >= 1 && data.vmixOverlayUrl.size() <= 300 &&
        data.status in ['active', 'disabled'] &&
        data.passwordVersion is int && data.passwordVersion >= 1 && data.passwordVersion <= 1000 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        isValidIsoTimestamp(data.createdAt) &&
        isValidIsoTimestamp(data.updatedAt);
    }

    function isValidLoginLookup(data, loginId) {
      return data.keys().hasAll([
          'loginId',
          'authEmail',
          'uid',
          'matchRoomId',
          'passwordVersion',
          'status',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'loginId',
          'authEmail',
          'uid',
          'matchRoomId',
          'passwordVersion',
          'status',
          'updatedAt'
        ]) &&
        isValidLoginId(data.loginId) && data.loginId == loginId &&
        data.authEmail is string && data.authEmail.size() >= 5 && data.authEmail.size() <= 120 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        isValidRoomId(data.matchRoomId) &&
        data.passwordVersion is int && data.passwordVersion >= 1 && data.passwordVersion <= 1000 &&
        data.status in ['active', 'disabled'] &&
        isValidIsoTimestamp(data.updatedAt);
    }

    function isValidScoreboard(data, roomId) {
      return data.keys().hasAll([
          'roomId',
          'ownerUid',
          'ownerLoginId',
          'teamAName',
          'teamBName',
          'teamAScore',
          'teamBScore',
          'stateJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomId',
          'ownerUid',
          'ownerLoginId',
          'teamAName',
          'teamBName',
          'teamAScore',
          'teamBScore',
          'stateJson',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidRoomId(data.roomId) && data.roomId == roomId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidLoginId(data.ownerLoginId) &&
        data.teamAName is string && data.teamAName.size() <= 60 &&
        data.teamBName is string && data.teamBName.size() <= 60 &&
        data.teamAScore is int && data.teamAScore >= 0 && data.teamAScore <= 999 &&
        data.teamBScore is int && data.teamBScore >= 0 && data.teamBScore <= 999 &&
        data.stateJson is string && data.stateJson.size() >= 2 && data.stateJson.size() <= 16000 &&
        isValidIsoTimestamp(data.createdAt) &&
        isValidIsoTimestamp(data.updatedAt);
    }

    function isValidUserProfileDoc(data, userId) {
      return data.keys().hasAll([
          'uid',
          'fullName',
          'loginId',
          'authEmail',
          'role',
          'status',
          'controlUrl',
          'scoreboardUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'fullName',
          'loginId',
          'authEmail',
          'role',
          'status',
          'controlUrl',
          'scoreboardUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
        isValidLoginId(data.loginId) &&
        data.authEmail is string && data.authEmail.size() >= 5 && data.authEmail.size() <= 120 &&
        data.role == 'user' &&
        data.status in ['active', 'disabled'] &&
        data.controlUrl is string && data.controlUrl.size() >= 1 && data.controlUrl.size() <= 300 &&
        data.scoreboardUrl is string && data.scoreboardUrl.size() >= 1 && data.scoreboardUrl.size() <= 300 &&
        isValidIsoTimestamp(data.createdAt) &&
        isValidIsoTimestamp(data.updatedAt);
    }

    function isValidUserLiveScoreboard(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'visible',
          'teamAScore',
          'teamAPlayersOnMat',
          'teamBScore',
          'teamBPlayersOnMat',
          'matchSeconds',
          'matchRunning',
          'matchUpdatedAt',
          'raidSeconds',
          'raidRunning',
          'raidUpdatedAt',
          'kabaddiHalf',
          'doOrDie',
          'version',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'visible',
          'teamAScore',
          'teamARaidPoints',
          'teamABonusPoints',
          'teamATacklePoints',
          'teamALonaPoints',
          'teamAPlayersOnMat',
          'teamAGreenCards',
          'teamAYellowCards',
          'teamARedCards',
          'teamABinEndAt',
          'teamBScore',
          'teamBRaidPoints',
          'teamBBonusPoints',
          'teamBTacklePoints',
          'teamBLonaPoints',
          'teamBPlayersOnMat',
          'teamBGreenCards',
          'teamBYellowCards',
          'teamBRedCards',
          'teamBBinEndAt',
          'matchSeconds',
          'matchRunning',
          'matchUpdatedAt',
          'raidSeconds',
          'raidRunning',
          'raidUpdatedAt',
          'kabaddiHalf',
          'matchStatus',
          'timeoutTeam',
          'doOrDie',
          'kabaddiAlert',
          'kabaddiGraphicPanel',
          'version',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.visible is bool &&
        data.teamAScore is int && data.teamAScore >= 0 && data.teamAScore <= 999 &&
        isOptionalBoundedInt(data, 'teamARaidPoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamABonusPoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamATacklePoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamALonaPoints', 0, 999) &&
        data.teamAPlayersOnMat is int && data.teamAPlayersOnMat >= 0 && data.teamAPlayersOnMat <= 7 &&
        isOptionalBoundedInt(data, 'teamAGreenCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamAYellowCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamARedCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamABinEndAt', 0, 9999999999999) &&
        data.teamBScore is int && data.teamBScore >= 0 && data.teamBScore <= 999 &&
        isOptionalBoundedInt(data, 'teamBRaidPoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamBBonusPoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamBTacklePoints', 0, 999) &&
        isOptionalBoundedInt(data, 'teamBLonaPoints', 0, 999) &&
        data.teamBPlayersOnMat is int && data.teamBPlayersOnMat >= 0 && data.teamBPlayersOnMat <= 7 &&
        isOptionalBoundedInt(data, 'teamBGreenCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamBYellowCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamBRedCards', 0, 99) &&
        isOptionalBoundedInt(data, 'teamBBinEndAt', 0, 9999999999999) &&
        data.matchSeconds is int && data.matchSeconds >= 0 && data.matchSeconds <= 3600 &&
        data.matchRunning is bool &&
        data.matchUpdatedAt is int && data.matchUpdatedAt >= 0 &&
        data.raidSeconds is int && data.raidSeconds >= 0 && data.raidSeconds <= 60 &&
        data.raidRunning is bool &&
        data.raidUpdatedAt is int && data.raidUpdatedAt >= 0 &&
        data.kabaddiHalf in ['1ST HALF', '2ND HALF', 'HALF TIME', 'FULL TIME'] &&
        (!('matchStatus' in data) || data.matchStatus in ['LIVE', 'PAUSED', 'TIMEOUT', 'HALF TIME', 'FULL TIME']) &&
        isOptionalBoundedString(data, 'timeoutTeam', 20) &&
        data.doOrDie is bool &&
        isOptionalBoundedString(data, 'kabaddiAlert', 120) &&
        isOptionalBoundedString(data, 'kabaddiGraphicPanel', 40) &&
        data.version is int && data.version >= 0 && data.version <= 100000000 &&
        data.updatedAt is int && data.updatedAt >= 0;
    }

    function isValidUserSettingsDoc(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'teamAName',
          'teamACode',
          'teamAColor',
          'teamBName',
          'teamBCode',
          'teamBColor',
          'kabaddiTitle',
          'kabaddiSubtitle',
          'version',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'teamAName',
          'teamACode',
          'teamAColor',
          'teamALogoUrl',
          'teamAStarting7',
          'teamBName',
          'teamBCode',
          'teamBColor',
          'teamBLogoUrl',
          'teamBStarting7',
          'kabaddiTitle',
          'kabaddiSubtitle',
          'kabaddiTag',
          'kabaddiVenue',
          'kabaddiLeague',
          'kabaddiEvent',
          'kabaddiMatchType',
          'sponsorName',
          'championTeam',
          'runnerUpTeam',
          'thirdPlaceTeam',
          'fourthPlaceTeam',
          'version',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.teamAName is string && data.teamAName.size() <= 60 &&
        data.teamACode is string && data.teamACode.size() <= 8 &&
        data.teamAColor is string && data.teamAColor.size() <= 20 &&
        isOptionalBoundedString(data, 'teamALogoUrl', 180000) &&
        isOptionalBoundedStringList(data, 'teamAStarting7', 7) &&
        data.teamBName is string && data.teamBName.size() <= 60 &&
        data.teamBCode is string && data.teamBCode.size() <= 8 &&
        data.teamBColor is string && data.teamBColor.size() <= 20 &&
        isOptionalBoundedString(data, 'teamBLogoUrl', 180000) &&
        isOptionalBoundedStringList(data, 'teamBStarting7', 7) &&
        data.kabaddiTitle is string && data.kabaddiTitle.size() <= 120 &&
        data.kabaddiSubtitle is string && data.kabaddiSubtitle.size() <= 140 &&
        isOptionalBoundedString(data, 'kabaddiTag', 40) &&
        isOptionalBoundedString(data, 'kabaddiVenue', 80) &&
        isOptionalBoundedString(data, 'kabaddiLeague', 80) &&
        isOptionalBoundedString(data, 'kabaddiEvent', 80) &&
        isOptionalBoundedString(data, 'kabaddiMatchType', 80) &&
        isOptionalBoundedString(data, 'sponsorName', 100) &&
        isOptionalBoundedString(data, 'championTeam', 60) &&
        isOptionalBoundedString(data, 'runnerUpTeam', 60) &&
        isOptionalBoundedString(data, 'thirdPlaceTeam', 60) &&
        isOptionalBoundedString(data, 'fourthPlaceTeam', 60) &&
        data.version is int && data.version >= 0 && data.version <= 100000000 &&
        data.updatedAt is int && data.updatedAt >= 0;
    }

    function isValidUserUndoHistory(data, userId) {
      return data.keys().hasAll(['ownerUid', 'entries', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'entries', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.entries is list &&
        data.entries.size() <= 40 &&
        (data.entries.size() == 0 || data.entries[0] is map) &&
        data.updatedAt is int && data.updatedAt >= 0;
    }

    function isValidUserScoreHistoryEvent(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'action',
          'teamAScore',
          'teamBScore',
          'teamAPlayersOnMat',
          'teamBPlayersOnMat',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'action',
          'team',
          'delta',
          'teamAScore',
          'teamBScore',
          'teamAPlayersOnMat',
          'teamBPlayersOnMat',
          'createdAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 60 &&
        isOptionalBoundedString(data, 'team', 12) &&
        isOptionalBoundedInt(data, 'delta', -99, 99) &&
        data.teamAScore is int && data.teamAScore >= 0 && data.teamAScore <= 999 &&
        data.teamBScore is int && data.teamBScore >= 0 && data.teamBScore <= 999 &&
        data.teamAPlayersOnMat is int && data.teamAPlayersOnMat >= 0 && data.teamAPlayersOnMat <= 7 &&
        data.teamBPlayersOnMat is int && data.teamBPlayersOnMat >= 0 && data.teamBPlayersOnMat <= 7 &&
        data.createdAt is int && data.createdAt >= 0;
    }

    function isValidUserCricketScoreboard(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'visible',
          'battingTeamCode',
          'bowlingTeamCode',
          'runs',
          'wickets',
          'totalBalls',
          'maxOvers',
          'tournamentText',
          'batter1Name',
          'batter1Runs',
          'batter1Balls',
          'batter2Name',
          'batter2Runs',
          'batter2Balls',
          'striker',
          'bowlerName',
          'bowlerWickets',
          'bowlerRuns',
          'bowlerBalls',
          'currentOverBalls',
          'version',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'visible',
          'battingTeamName',
          'battingTeamCode',
          'battingFlagId',
          'battingLogoUrl',
          'bowlingTeamName',
          'bowlingTeamCode',
          'bowlingFlagId',
          'bowlingLogoUrl',
          'runs',
          'wickets',
          'totalBalls',
          'maxOvers',
          'tournamentText',
          'batter1Name',
          'batter1Runs',
          'batter1Balls',
          'batter2Name',
          'batter2Runs',
          'batter2Balls',
          'striker',
          'bowlerName',
          'bowlerWickets',
          'bowlerRuns',
          'bowlerBalls',
          'currentOverBalls',
          'matchJson',
          'version',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.visible is bool &&
        isOptionalBoundedString(data, 'battingTeamName', 50) &&
        data.battingTeamCode is string && data.battingTeamCode.size() >= 1 && data.battingTeamCode.size() <= 8 &&
        isOptionalBoundedString(data, 'battingFlagId', 20) &&
        isOptionalBoundedString(data, 'battingLogoUrl', 180000) &&
        isOptionalBoundedString(data, 'bowlingTeamName', 50) &&
        data.bowlingTeamCode is string && data.bowlingTeamCode.size() >= 1 && data.bowlingTeamCode.size() <= 8 &&
        isOptionalBoundedString(data, 'bowlingFlagId', 20) &&
        isOptionalBoundedString(data, 'bowlingLogoUrl', 180000) &&
        data.runs is int && data.runs >= 0 && data.runs <= 9999 &&
        data.wickets is int && data.wickets >= 0 && data.wickets <= 10 &&
        data.totalBalls is int && data.totalBalls >= 0 && data.totalBalls <= 6000 &&
        data.maxOvers is int && data.maxOvers >= 1 && data.maxOvers <= 500 &&
        data.tournamentText is string && data.tournamentText.size() <= 80 &&
        data.batter1Name is string && data.batter1Name.size() <= 40 &&
        data.batter1Runs is int && data.batter1Runs >= 0 && data.batter1Runs <= 999 &&
        data.batter1Balls is int && data.batter1Balls >= 0 && data.batter1Balls <= 999 &&
        data.batter2Name is string && data.batter2Name.size() <= 40 &&
        data.batter2Runs is int && data.batter2Runs >= 0 && data.batter2Runs <= 999 &&
        data.batter2Balls is int && data.batter2Balls >= 0 && data.batter2Balls <= 999 &&
        data.striker in [1, 2] &&
        data.bowlerName is string && data.bowlerName.size() <= 40 &&
        data.bowlerWickets is int && data.bowlerWickets >= 0 && data.bowlerWickets <= 10 &&
        data.bowlerRuns is int && data.bowlerRuns >= 0 && data.bowlerRuns <= 999 &&
        data.bowlerBalls is int && data.bowlerBalls >= 0 && data.bowlerBalls <= 600 &&
        data.currentOverBalls is list && data.currentOverBalls.size() <= 16 &&
        (data.currentOverBalls.size() == 0 || (data.currentOverBalls[0] is string && data.currentOverBalls[0].size() <= 8)) &&
        isOptionalBoundedString(data, 'matchJson', 260000) &&
        data.version is int && data.version >= 0 && data.version <= 100000000 &&
        data.updatedAt is int && data.updatedAt >= 0;
    }

    // 1. Super Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isSuperAdmin() || isOwner(adminUid));
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminUid) && isSuperAdmin() && isValidAdminRecord(request.resource.data, adminUid);
      allow delete: if isValidId(adminUid) && isSuperAdmin();
    }

    // 2. Operator User Accounts (Self-signup allowed strictly for own role='user'; updates/deletes/list strictly Super Admin)
    match /userAccounts/{userUid} {
      allow get: if isValidId(userUid) && (isSuperAdmin() || isOwner(userUid));
      allow list: if isSuperAdmin();
      allow create: if isValidId(userUid) && isValidUserAccount(request.resource.data, userUid) && (
        isSuperAdmin() ||
        (
          isOwner(userUid) &&
          request.resource.data.role == 'user' &&
          request.resource.data.status == 'active' &&
          request.resource.data.passwordVersion == 1 &&
          request.resource.data.createdByUid == request.auth.uid
        )
      );
      allow update: if isValidId(userUid) && isSuperAdmin() &&
        isValidUserAccount(request.resource.data, userUid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.loginId == resource.data.loginId &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(userUid) && isSuperAdmin();
    }

    // 3. Non-PII Login ID Lookup (exact-key get for sign-in/uniqueness; self-signup can only create unused ID for own uid)
    match /loginLookup/{loginId} {
      allow get: if isValidLoginId(loginId);
      allow list: if isSuperAdmin();
      allow create: if isValidLoginId(loginId) && isValidLoginLookup(request.resource.data, loginId) && (
        isSuperAdmin() ||
        (
          isAuthenticated() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.passwordVersion == 1
        )
      );
      allow update: if isValidLoginId(loginId) && isSuperAdmin() && isValidLoginLookup(request.resource.data, loginId);
      allow delete: if isValidLoginId(loginId) && isSuperAdmin();
    }

    // 4. Legacy Isolated Per-User Kabaddi Scoreboards
    match /scoreboards/{roomId} {
      allow get: if isValidRoomId(roomId) && (isSuperAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid));
      allow list: if isSuperAdmin();
      allow create: if isValidRoomId(roomId) && isValidScoreboard(request.resource.data, roomId) && (
        isSuperAdmin() ||
        (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid)
      );
      allow update: if isValidRoomId(roomId) && isValidScoreboard(request.resource.data, roomId) &&
        request.resource.data.roomId == resource.data.roomId &&
        request.resource.data.createdAt == resource.data.createdAt && (
          isSuperAdmin() ||
          (
            isAuthenticated() &&
            resource.data.ownerUid == request.auth.uid &&
            request.resource.data.ownerUid == resource.data.ownerUid &&
            request.resource.data.ownerLoginId == resource.data.ownerLoginId
          )
        );
      allow delete: if isValidRoomId(roomId) && isSuperAdmin();
    }

    // 5. Hierarchical Per-User Isolated Kabaddi System (/users/{userId}/...)
    match /users/{userId} {
      // 5a. Private User Profile (strictly owner or Super Admin — ZERO public exposure)
      match /profile/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isSuperAdmin() || isOwner(userId));
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && docId == 'main' &&
          isValidUserProfileDoc(request.resource.data, userId) && (
            isSuperAdmin() ||
            (isOwner(userId) && request.resource.data.role == 'user' && request.resource.data.status == 'active')
          );
        allow update: if isValidId(userId) && docId == 'main' &&
          isSuperAdmin() &&
          isValidUserProfileDoc(request.resource.data, userId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdmin();
      }

      // 5b. Live Scoreboard State (Non-PII: exact-key get allowed for unauthenticated vMix/OBS /scoreboard/{userId}; writes strictly owner or Super Admin)
      match /scoreboard/{docId} {
        allow get: if isValidId(userId) && docId == 'current';
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && docId == 'current' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserLiveScoreboard(request.resource.data, userId);
        allow update: if isValidId(userId) && docId == 'current' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserLiveScoreboard(request.resource.data, userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdmin();
      }

      // 5c. Permanent Settings & Custom Text (Non-PII: exact-key get allowed for vMix/OBS /scoreboard/{userId}; writes strictly owner or Super Admin)
      match /settings/{docId} {
        allow get: if isValidId(userId) && docId == 'main';
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && docId == 'main' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserSettingsDoc(request.resource.data, userId);
        allow update: if isValidId(userId) && docId == 'main' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserSettingsDoc(request.resource.data, userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdmin();
      }

      // 5d. Private Per-User Undo History Stack (strictly owner or Super Admin)
      match /undoHistory/{docId} {
        allow get: if isValidId(userId) && docId == 'stack' && (isSuperAdmin() || isOwner(userId));
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && docId == 'stack' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserUndoHistory(request.resource.data, userId);
        allow update: if isValidId(userId) && docId == 'stack' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserUndoHistory(request.resource.data, userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isValidId(userId) && isValidId(docId) && (isSuperAdmin() || isOwner(userId));
      }

      // 5e. Private Per-User Score History Log (append-only; strictly owner or Super Admin)
      match /scoreHistory/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && (isSuperAdmin() || isOwner(userId));
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && isValidId(eventId) &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserScoreHistoryEvent(request.resource.data, userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(eventId) && (isSuperAdmin() || isOwner(userId));
      }

      // 5f. Live Single Cricket Scoreboard State (Non-PII: exact-key get allowed for vMix/OBS /cricket-overlay/{userId}; writes strictly owner or Super Admin)
      match /cricket/{docId} {
        allow get: if isValidId(userId) && docId == 'current';
        allow list: if isSuperAdmin() || isOwner(userId);
        allow create: if isValidId(userId) && docId == 'current' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserCricketScoreboard(request.resource.data, userId);
        allow update: if isValidId(userId) && docId == 'current' &&
          (isSuperAdmin() || isOwner(userId)) &&
          isValidUserCricketScoreboard(request.resource.data, userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdmin();
      }
    }
  }
}
