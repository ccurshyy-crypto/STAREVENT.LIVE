                </linearGradient>
              </defs>
              <circle cx="30" cy="30" r="25.5" fill="#172554" stroke="url(#rrGold)" stroke-width="2.8"/>
              <circle cx="30" cy="30" r="20.5" fill="none" stroke="#ec4899" stroke-width="1.3"/>
              <text x="30" y="32" text-anchor="middle" fill="#facc15" font-family="Oswald, sans-serif" font-weight="700" font-size="18.5" letter-spacing="0.5" id="svgRightText">RR</text>
              <text x="30" y="43.5" text-anchor="middle" fill="#ffffff" font-family="Inter, sans-serif" font-weight="800" font-size="6.5" letter-spacing="0.7">ROYALS</text>
            </svg>
          </div>
        </div>
