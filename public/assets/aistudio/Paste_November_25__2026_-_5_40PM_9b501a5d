<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>2021-2022 TATA IPL Animated Broadcast Scoreboard Overlay</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&family=Oswald:wght@600;700&family=Roboto+Condensed:ital,wght@0,700;0,800;0,900;1,800;1,900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bat-bg-top: #eef6ff;
      --bat-bg-mid: #d9ebfc;
      --bat-bg-bot: #c3def8;
      --score-gold-top: #ffe05d;
      --score-gold-mid: #f7c01d;
      --score-gold-bot: #e09e04;
      --bowl-pink-top: #f0236b;
      --bowl-pink-mid: #d81b60;
      --bowl-pink-bot: #9c1147;
      --navy-ink: #081024;
      --sub-bar-top: #141c2f;
      --sub-bar-bot: #070b14;
      --chrome-bright: #ffffff;
      --chrome-mid: #cbd5e1;
      --chrome-dark: #475569;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Pure transparent canvas for OBS Studio / vMix Browser Source */
    html, body {
      width: 100%;
      height: 100%;
      background: transparent !important;
      overflow: hidden;
      font-family: 'Roboto Condensed', 'Inter', sans-serif;
      user-select: none;
    }

    /* =========================================================
       LOWER-THIRD BROADCAST STAGE
    ========================================================= */
    .broadcast-stage {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 34px;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      padding: 0 28px;
      pointer-events: none;
    }

    /* Main Scoreboard Bar ("Ek Patti Jaisa") with Center-Out Reveal */
    .ipl-patti-wrapper {
      width: 100%;
      max-width: 1760px;
      height: 64px;
      display: flex;
      align-items: stretch;
      position: relative;
      filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.78));
      animation: pattiCenterReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, clip-path;
    }

    @keyframes pattiCenterReveal {
      0% {
        opacity: 0;
        transform: translateY(28px) scaleX(0.45);
        clip-path: inset(0 45% 0 45%);
      }
      45% {
        opacity: 1;
        transform: translateY(0) scaleX(1.01);
        clip-path: inset(0 0% 0 0%);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scaleX(1);
        clip-path: inset(0 0% 0 0%);
      }
    }

    /* =========================================================
       ANGLED DARK METALLIC TEAM SHIELD WINGS (LEFT & RIGHT)
    ========================================================= */
    .wing-shield-left,
    .wing-shield-right {
      width: 158px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 4;
      overflow: hidden;
    }

    /* Outer chrome bevel frame */
    .wing-shield-left {
      background: linear-gradient(180deg, #f8fafc 0%, #94a3b8 48%, #334155 100%);
      clip-path: polygon(0 5px, 100% 0, 86% 100%, 16% 100%);
      margin-right: -18px;
      padding: 2.5px 3px 2.5px 3px;
      animation: wingSlideLeft 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.1s backwards;
    }

    .wing-shield-right {
      background: linear-gradient(180deg, #f8fafc 0%, #94a3b8 48%, #334155 100%);
      clip-path: polygon(0 0, 100% 5px, 84% 100%, 14% 100%);
      margin-left: -18px;
      padding: 2.5px 3px 2.5px 3px;
      animation: wingSlideRight 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.1s backwards;
    }

    @keyframes wingSlideLeft {
      0% { transform: translateX(65px); opacity: 0; }
      100% { transform: translateX(0); opacity: 1; }
    }

    @keyframes wingSlideRight {
      0% { transform: translateX(-65px); opacity: 0; }
      100% { transform: translateX(0); opacity: 1; }
    }

    .wing-inner-left {
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 45% 40%, #2a3346 0%, #101522 58%, #060911 100%);
      clip-path: polygon(1px 5px, calc(100% - 2px) 1px, calc(86% - 1px) 100%, calc(16% + 1px) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .wing-inner-right {
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 55% 40%, #2d1e3e 0%, #111524 58%, #060911 100%);
      clip-path: polygon(2px 1px, calc(100% - 1px) 5px, calc(84% - 1px) 100%, calc(14% + 1px) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Subtle starfield/sparkle dots inside wing panels like 2022 IPL broadcast */
    .wing-inner-left::before,
    .wing-inner-right::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.35) 1px, transparent 1px),
        radial-gradient(rgba(56, 189, 248, 0.25) 1px, transparent 1px);
      background-size: 18px 18px, 26px 26px;
      background-position: 0 0, 9px 11px;
      opacity: 0.45;
      pointer-events: none;
    }

    /* Continuous metallic sheen sweep across wings */
    .wing-inner-left::after,
    .wing-inner-right::after {
      content: '';
      position: absolute;
      top: -20%;
      left: -120%;
      width: 70%;
      height: 140%;
      background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.24) 50%, transparent 80%);
      transform: skewX(-22deg);
      animation: wingSheenLoop 6.5s ease-in-out infinite;
      pointer-events: none;
    }

    .wing-inner-right::after {
      animation-delay: 0.35s;
    }

    @keyframes wingSheenLoop {
      0%, 68% { left: -120%; }
      88%, 100% { left: 170%; }
    }

    .team-crest-box {
      width: 58px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
      animation: crestFloat 4.5s ease-in-out infinite;
    }

    @keyframes crestFloat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.035); }
    }

    .team-crest-box img {
      max-width: 54px;
      max-height: 48px;
      object-fit: contain;
      filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.75));
    }

    /* =========================================================
       CENTRAL SINGLE-LINE PATTI CORE
    ========================================================= */
    .patti-core {
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 2;
      background: #080d1a;
      border-top: 2.5px solid #f8fafc;
      border-bottom: 2.5px solid #94a3b8;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.85),
        inset 0 -1px 0 rgba(255, 255, 255, 0.35);
      overflow: hidden;
    }

    /* Full-bar entrance & periodic broadcast light sweep */
    .patti-core::after {
      content: '';
      position: absolute;
      top: 0;
      left: -45%;
      width: 35%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.28) 48%,
        rgba(255, 255, 255, 0.45) 50%,
        rgba(255, 255, 255, 0.28) 52%,
        transparent 100%
      );
      transform: skewX(-28deg);
      pointer-events: none;
      z-index: 15;
      animation: barMetallicSweep 7s cubic-bezier(0.4, 0, 0.2, 1) 0.45s infinite;
    }

    @keyframes barMetallicSweep {
      0% { left: -45%; opacity: 0; }
      4% { opacity: 1; }
      18% { left: 135%; opacity: 1; }
      20%, 100% { left: 135%; opacity: 0; }
    }

    /* Upper Primary Row (Height: 39px) */
    .patti-top-band {
      height: 39px;
      display: flex;
      align-items: stretch;
      width: 100%;
      position: relative;
    }

    /* ---------------------------------------------------------
       1. LEFT-CENTER: BATTING TEAM & GOLD SCORE BOX
    --------------------------------------------------------- */
    .seg-team-score {
      width: 29%;
      background: linear-gradient(180deg, var(--bat-bg-top) 0%, var(--bat-bg-mid) 55%, var(--bat-bg-bot) 100%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px 0 26px;
      border-right: 1.5px solid #93c5fd;
      position: relative;
    }

    .bat-team-wrap {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    /* Animated Live Broadcast Dot */
    .live-pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #e11d48;
      box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.75);
      animation: liveDotPulse 2s infinite;
      flex-shrink: 0;
    }

    @keyframes liveDotPulse {
      0% { transform: scale(0.92); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.75); }
      70% { transform: scale(1.05); box-shadow: 0 0 0 6px rgba(225, 29, 72, 0); }
      100% { transform: scale(0.92); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
    }

    .bat-team-code {
      font-family: 'Oswald', 'Roboto Condensed', sans-serif;
      font-weight: 700;
      font-size: 26px;
      color: var(--navy-ink);
      letter-spacing: 0.7px;
      line-height: 1;
      text-transform: uppercase;
    }

    .score-gold-box {
      background: linear-gradient(180deg, var(--score-gold-top) 0%, var(--score-gold-mid) 52%, var(--score-gold-bot) 100%);
      color: var(--navy-ink);
      font-family: 'Roboto Condensed', sans-serif;
      font-weight: 900;
      font-size: 26px;
      padding: 1px 18px;
      border-radius: 2px;
      line-height: 1.08;
      letter-spacing: 0.5px;
      border-top: 1px solid rgba(255, 255, 255, 0.8);
      border-bottom: 1px solid rgba(146, 64, 14, 0.45);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.24);
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 96px;
    }

    .score-gold-box.digit-flip {
      animation: scoreFlipPop 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes scoreFlipPop {
      0% { transform: perspective(300px) rotateX(0deg) scale(1); }
      40% { transform: perspective(300px) rotateX(-24deg) scale(1.1); filter: brightness(1.18); }
      100% { transform: perspective(300px) rotateX(0deg) scale(1); filter: brightness(1); }
    }

    .overs-display {
      font-family: 'Roboto Condensed', sans-serif;
      font-weight: 900;
      font-size: 18px;
      color: var(--navy-ink);
      letter-spacing: 0.3px;
      transition: transform 0.25s ease;
    }

    /* ---------------------------------------------------------
       2. CENTER: BATSMEN (PAPYA & SURAJ)
    --------------------------------------------------------- */
    .seg-batsmen {
      width: 35%;
      background: linear-gradient(180deg, #f5faff 0%, #e1effd 55%, #cde3fa 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-right: 1.5px solid #93c5fd;
    }

    .batter-line {
      height: 19.5px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px 0 13px;
      color: var(--navy-ink);
      transition: background-color 0.25s ease;
    }

    .batter-line:first-child {
      border-bottom: 1px solid rgba(14, 116, 144, 0.2);
    }

    .batter-line.is-striker {
      background: linear-gradient(90deg, rgba(56, 189, 248, 0.16) 0%, rgba(255, 255, 255, 0.35) 50%, transparent 100%);
    }

    .batter-left {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
    }

    /* Glowing Pulsing Striker Triangle (▷) */
    .strike-arrow {
      font-size: 11px;
      font-weight: 900;
      color: var(--navy-ink);
      width: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.2s ease, transform 0.2s ease;
      animation: strikerTrianglePulse 1.35s ease-in-out infinite;
    }

    @keyframes strikerTrianglePulse {
      0%, 100% {
        transform: translateX(0) scale(1);
        color: #081024;
        text-shadow: 0 0 0 transparent;
      }
      50% {
        transform: translateX(2.5px) scale(1.18);
        color: #0284c7;
        text-shadow: 0 0 8px rgba(2, 132, 199, 0.65);
      }
    }

    .strike-arrow.inactive {
      opacity: 0;
      animation: none;
    }

    .batter-name {
      font-family: 'Roboto Condensed', sans-serif;
      font-weight: 800;
      font-size: 16px;
      letter-spacing: 0.45px;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .batter-line.is-striker .batter-name {
      font-weight: 900;
      color: #040916;
    }

    .batter-stats {
      display: flex;
      align-items: baseline;
      gap: 12px;
      font-family: 'Roboto Condensed', sans-serif;
    }

    .batter-runs {
      font-weight: 900;
      font-size: 17px;
      color: var(--navy-ink);
      min-width: 20px;
      text-align: right;
      display: inline-block;
    }

    .batter-balls {
      font-weight: 700;
      font-size: 13.5px;
      color: #334155;
      min-width: 18px;
      text-align: right;
      display: inline-block;
    }

    .num-bump {
      animation: numPop 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes numPop {
      0% { transform: translateY(4px) scale(0.88); opacity: 0.6; }
      55% { transform: translateY(-2px) scale(1.15); opacity: 1; }
      100% { transform: translateY(0) scale(1); opacity: 1; }
    }

    /* ---------------------------------------------------------
       3. RIGHT-CENTER: BOWLER BAR (CRUSHYY - MAGENTA/PINK)
    --------------------------------------------------------- */
    .seg-bowler {
      width: 36%;
      background: linear-gradient(90deg, var(--bowl-pink-top) 0%, var(--bowl-pink-mid) 54%, var(--bowl-pink-bot) 100%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 26px 0 16px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    /* Subtle gloss highlight on top half of pink bowler strip */
    .seg-bowler::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 48%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.02) 100%);
      pointer-events: none;
    }

    .bowler-info-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      position: relative;
      z-index: 2;
    }

    .bowler-name {
      font-family: 'Roboto Condensed', sans-serif;
      font-weight: 900;
      font-size: 18px;
      letter-spacing: 0.55px;
      text-transform: uppercase;
      color: #ffffff;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.42);
      white-space: nowrap;
    }

    /* Optional Over Balls Timeline Dots */
    .over-balls-strip {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .over-balls-strip.hidden {
      display: none;
    }

    .ball-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.22);
      border: 1px solid rgba(255, 255, 255, 0.55);
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 900;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      animation: dotEnter 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes dotEnter {
      0% { transform: scale(0); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .ball-dot.boundary {
      background: #facc15;
      color: #081024;
      border-color: #fef08a;
    }

    .ball-dot.wicket {
      background: #080d1a;
      color: #ff4d6d;
      border-color: #ffccd5;
    }

    .bowler-figures-box {
      display: flex;
      align-items: baseline;
      gap: 9px;
      font-family: 'Roboto Condensed', sans-serif;
      position: relative;
      z-index: 2;
    }

    .bowler-figs {
      font-weight: 900;
      font-size: 20px;
      color: #ffffff;
      letter-spacing: 0.4px;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.42);
    }

    .bowler-overs {
      font-weight: 800;
      font-size: 14.5px;
      color: #fce7f3;
    }

    /* ---------------------------------------------------------
       4. LOWER SLIM DARK NAVY SUB-BAR (HEIGHT: 20px)
    --------------------------------------------------------- */
    .patti-bottom-band {
      height: 20px;
      background: linear-gradient(180deg, var(--sub-bar-top) 0%, var(--sub-bar-bot) 100%);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 26px;
      color: #f8fafc;
      font-family: 'Roboto Condensed', sans-serif;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.55px;
      text-transform: uppercase;
      position: relative;
    }

    .sub-left {
      display: flex;
      align-items: center;
      gap: 44px;
    }

    .sub-vs {
      color: #e2e8f0;
      font-weight: 800;
    }

    .sub-target {
      color: #ffffff;
      font-weight: 900;
      letter-spacing: 0.6px;
    }

    .sub-right {
      color: #f8fafc;
      font-weight: 900;
      letter-spacing: 0.65px;
    }

    /* =========================================================
       FULL-WIDTH BROADCAST EVENT STINGER BANNER
       (FOUR!, SIX!, WICKET!, FREE HIT, TARGET CHASED)
    ========================================================= */
    .event-banner-overlay {
      position: absolute;
      inset: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transform: scaleX(0.05);
      transition: transform 0.36s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
    }

    .event-banner-overlay.active {
      opacity: 1;
      transform: scaleX(1);
    }

    /* Theme variations for Broadcast Events */
    .event-banner-overlay.theme-four {
      background: linear-gradient(90deg, #0284c7 0%, #0ea5e9 25%, #38bdf8 50%, #0ea5e9 75%, #0284c7 100%);
      border-top: 2px solid #e0f2fe;
      border-bottom: 2px solid #0369a1;
    }

    .event-banner-overlay.theme-six {
      background: linear-gradient(90deg, #6d28d9 0%, #8b5cf6 25%, #f59e0b 50%, #8b5cf6 75%, #6d28d9 100%);
      border-top: 2px solid #fef08a;
      border-bottom: 2px solid #4c1d95;
    }

    .event-banner-overlay.theme-wicket {
      background: linear-gradient(90deg, #991b1b 0%, #dc2626 28%, #ef4444 50%, #dc2626 72%, #991b1b 100%);
      border-top: 2px solid #fecaca;
      border-bottom: 2px solid #7f1d1d;
    }

    .event-banner-overlay.theme-freehit {
      background: linear-gradient(90deg, #b45309 0%, #f59e0b 28%, #fde047 50%, #f59e0b 72%, #b45309 100%);
      border-top: 2px solid #fef9c3;
      border-bottom: 2px solid #78350f;
    }

    .event-banner-overlay.theme-chased {
      background: linear-gradient(90deg, #065f46 0%, #10b981 28%, #facc15 50%, #10b981 72%, #065f46 100%);
      border-top: 2px solid #fef08a;
      border-bottom: 2px solid #064e3b;
    }

    /* Animated diagonal light rays behind event text */
    .event-banner-overlay::before {
      content: '';
      position: absolute;
      inset: -50%;
      background: repeating-linear-gradient(
        -55deg,
        rgba(255, 255, 255, 0.14) 0px,
        rgba(255, 255, 255, 0.14) 18px,
        transparent 18px,
        transparent 36px
      );
      animation: eventStripesMove 1.2s linear infinite;
    }

    @keyframes eventStripesMove {
      0% { transform: translateX(0); }
      100% { transform: translateX(50px); }
    }

    .event-content-box {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 0 36px;
    }

    .event-badge-pill {
      background: #081024;
      color: #facc15;
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: 1.5px;
      padding: 3px 14px;
      border-radius: 3px;
      border: 1px solid rgba(255, 255, 255, 0.45);
      text-transform: uppercase;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.45);
    }

    .event-main-headline {
      font-family: 'Oswald', 'Roboto Condensed', sans-serif;
      font-weight: 700;
      font-style: italic;
      font-size: 38px;
      letter-spacing: 2.5px;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 0 3px 10px rgba(0, 0, 0, 0.55);
      animation: eventHeadlineZoom 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .theme-freehit .event-main-headline,
    .theme-chased .event-main-headline {
      color: #081024;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .event-sub-caption {
      font-family: 'Roboto Condensed', sans-serif;
      font-weight: 900;
      font-size: 16px;
      letter-spacing: 1px;
      color: rgba(255, 255, 255, 0.95);
      background: rgba(8, 16, 36, 0.45);
      padding: 4px 12px;
      border-radius: 3px;
      text-transform: uppercase;
    }

    @keyframes eventHeadlineZoom {
      0% { transform: scale(1.65); letter-spacing: 8px; opacity: 0; }
      100% { transform: scale(1); letter-spacing: 2.5px; opacity: 1; }
    }

    /* =========================================================
       RESPONSIVE SCALING FOR NON-1080P PREVIEWS
    ========================================================= */
    @media (max-width: 1180px) {
      .wing-shield-left,
      .wing-shield-right {
        width: 105px;
