# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# OVERLAY_ADMIN_PIN: Owner secret password for the Owner Unlock Key Console.
OVERLAY_ADMIN_PIN=

# Cashfree Payment Gateway (Official PG API - start with sandbox)
# Get Sandbox keys from Cashfree Dashboard -> Developers -> API Keys
# Webhook URL: <APP_URL>/api/payment/cashfree/webhook
# Note: Cashfree PG signs webhooks using your Cashfree Client Secret Key (CASHFREE_CLIENT_SECRET).
# There is no separate webhook secret in Cashfree PG — leave CASHFREE_WEBHOOK_SECRET blank to
# reuse CASHFREE_CLIENT_SECRET, or set it to the exact same Cashfree Client Secret Key.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=
