    </div>
  </div>

  <script>
    /**
     * 2021-2022 TATA IPL Animated Broadcast Scoreboard Overlay
     * Pure transparent OBS / vMix Browser Source build with:
     * - window.updateScoreboard(data) API
     * - window.triggerEvent(type, customCaption) API
     * - URL Query Parameter configuration (?bat=GT&bowl=RR&score=86-3...)
     * - postMessage listener for external controller dashboards
     * - Silent keyboard hotkeys (1, 2, 3, 4, 6, W, S, R, F, C)
     */
    const DEFAULT_STATE = {
      bat: 'GT',
      bowl: 'RR',
      score: '86-3',
      overs: '13.2',
      target: 'TARGET 131',
      p1: 'PAPYA',
      p1r: 0,
      p1b: 0,
      p2: 'SURAJ',
      p2r: 31,
      p2b: 33,
      striker: 1, // 1 = top batsman on strike, 2 = bottom batsman on strike
      bowler: 'CRUSHYY',
      bfig: '1-17',
      bov: '3.2',
      tour: 'TATA IPL 2022 - THE FINAL',
      balls: [],
      showBalls: false,
      leftLogo: '',
      rightLogo: ''
    };

    let state = { ...DEFAULT_STATE };
    let eventTimer = null;

    // Parse initial URL query parameters
    function parseQueryParams() {
      const params = new URLSearchParams(window.location.search);
      const updates = {};

      if (params.has('bat')) updates.bat = params.get('bat').toUpperCase();
      if (params.has('bowl')) updates.bowl = params.get('bowl').toUpperCase();
      if (params.has('score')) updates.score = params.get('score');
      if (params.has('overs')) updates.overs = params.get('overs');

      if (params.has('target')) {
        const rawT = params.get('target').trim();
        updates.target = /^\d+$/.test(rawT) ? `TARGET ${rawT}` : rawT.toUpperCase();
      }

      if (params.has('p1')) updates.p1 = params.get('p1').toUpperCase();
      if (params.has('p1r')) updates.p1r = parseInt(params.get('p1r'), 10) || 0;
      if (params.has('p1b')) updates.p1b = parseInt(params.get('p1b'), 10) || 0;

      if (params.has('p2')) updates.p2 = params.get('p2').toUpperCase();
      if (params.has('p2r')) updates.p2r = parseInt(params.get('p2r'), 10) || 0;
      if (params.has('p2b')) updates.p2b = parseInt(params.get('p2b'), 10) || 0;

      if (params.has('striker')) {
        updates.striker = parseInt(params.get('striker'), 10) === 2 ? 2 : 1;
      }

      if (params.has('bowler')) updates.bowler = params.get('bowler').toUpperCase();
      if (params.has('bfig')) updates.bfig = params.get('bfig');
      if (params.has('bov')) updates.bov = params.get('bov');
      if (params.has('tour')) updates.tour = params.get('tour').toUpperCase();

      if (params.has('balls')) {
        const bStr = params.get('balls').trim();
        updates.balls = bStr ? bStr.split(',').map(s => s.trim()).filter(Boolean) : [];
        updates.showBalls = updates.balls.length > 0;
      }

      if (params.has('leftLogo')) updates.leftLogo = params.get('leftLogo');
      if (params.has('rightLogo')) updates.rightLogo = params.get('rightLogo');

      return updates;
    }

    // Trigger CSS animation reflow cleanly on any element
    function animateElement(el, className) {
      if (!el) return;
      el.classList.remove(className);
      void el.offsetWidth;
      el.classList.add(className);
    }

    // Render left & right team crests (custom image URL or vector shield)
    function renderCrests() {
      const leftBox = document.getElementById('leftCrestContainer');
      const rightBox = document.getElementById('rightCrestContainer');

      if (state.leftLogo) {
        leftBox.innerHTML = `<img src="${state.leftLogo}" alt="${state.bat}" />`;
      } else {
        const label = state.bat === 'GT' ? 'TITANS' : state.bat;
        leftBox.innerHTML = `
          <svg width="54" height="48" viewBox="0 0 64 56">
            <polygon points="32,3 57,14 50,44 32,53 14,44 7,14" fill="#121a2b" stroke="#eab308" stroke-width="2.6"/>
            <path d="M16,19 L32,11 L48,19" fill="none" stroke="#38bdf8" stroke-width="2.2"/>
            <text x="32" y="34" text-anchor="middle" fill="#ffffff" font-family="Oswald, sans-serif" font-weight="700" font-size="13.5" letter-spacing="0.6">${label}</text>
            <path d="M17,40 L47,40" stroke="#eab308" stroke-width="2.2"/>
          </svg>
        `;
      }

      if (state.rightLogo) {
        rightBox.innerHTML = `<img src="${state.rightLogo}" alt="${state.bowl}" />`;
      } else {
        const shortCode = state.bowl;
        const subLabel = shortCode === 'RR' ? 'ROYALS' : 'IPL';
        rightBox.innerHTML = `
          <svg width="52" height="50" viewBox="0 0 60 60">
            <circle cx="30" cy="30" r="25.5" fill="#172554" stroke="#facc15" stroke-width="2.8"/>
            <circle cx="30" cy="30" r="20.5" fill="none" stroke="#ec4899" stroke-width="1.3"/>
            <text x="30" y="32" text-anchor="middle" fill="#facc15" font-family="Oswald, sans-serif" font-weight="700" font-size="18.5" letter-spacing="0.5">${shortCode}</text>
            <text x="30" y="43.5" text-anchor="middle" fill="#ffffff" font-family="Inter, sans-serif" font-weight="800" font-size="6.5" letter-spacing="0.7">${subLabel}</text>
          </svg>
        `;
      }
    }

    // Update DOM with smooth digit flip/pop transitions when values change
    function renderScoreboard(prevState) {
      document.getElementById('dispBatTeam').textContent = state.bat;
      document.getElementById('dispVsTeam').textContent = `v ${state.bowl}`;
      document.getElementById('dispTargetText').textContent = state.target;
      document.getElementById('dispMatchTitle').textContent = state.tour;

      const scoreEl = document.getElementById('dispScoreBox');
      if (!prevState || prevState.score !== state.score) {
        scoreEl.textContent = state.score;
        if (prevState) animateElement(scoreEl, 'digit-flip');
      }

      const oversEl = document.getElementById('dispOvers');
      if (!prevState || prevState.overs !== state.overs) {
        oversEl.textContent = state.overs;
        if (prevState) animateElement(oversEl, 'num-bump');
      }

      // Batsman 1 (Top)
      document.getElementById('dispBatter1Name').textContent = state.p1;
      const p1rEl = document.getElementById('dispBatter1Runs');
      const p1bEl = document.getElementById('dispBatter1Balls');
      if (!prevState || prevState.p1r !== state.p1r) {
        p1rEl.textContent = state.p1r;
        if (prevState) animateElement(p1rEl, 'num-bump');
      }
      if (!prevState || prevState.p1b !== state.p1b) {
        p1bEl.textContent = state.p1b;
        if (prevState) animateElement(p1bEl, 'num-bump');
      }

      // Batsman 2 (Bottom)
      document.getElementById('dispBatter2Name').textContent = state.p2;
      const p2rEl = document.getElementById('dispBatter2Runs');
      const p2bEl = document.getElementById('dispBatter2Balls');
      if (!prevState || prevState.p2r !== state.p2r) {
        p2rEl.textContent = state.p2r;
        if (prevState) animateElement(p2rEl, 'num-bump');
      }
      if (!prevState || prevState.p2b !== state.p2b) {
        p2bEl.textContent = state.p2b;
        if (prevState) animateElement(p2bEl, 'num-bump');
      }

      // Striker Indicator Arrow (▷)
      const row1 = document.getElementById('rowBatter1');
      const row2 = document.getElementById('rowBatter2');
      const arr1 = document.getElementById('arrowBatter1');
      const arr2 = document.getElementById('arrowBatter2');

      if (state.striker === 1) {
        row1.classList.add('is-striker');
        row2.classList.remove('is-striker');
        arr1.classList.remove('inactive');
        arr2.classList.add('inactive');
      } else {
        row1.classList.remove('is-striker');
        row2.classList.add('is-striker');
        arr1.classList.add('inactive');
        arr2.classList.remove('inactive');
      }

      // Bowler
      document.getElementById('dispBowlerName').textContent = state.bowler;
      const bfigEl = document.getElementById('dispBowlerFigs');
      const bovEl = document.getElementById('dispBowlerOvers');
      if (!prevState || prevState.bfig !== state.bfig) {
        bfigEl.textContent = state.bfig;
        if (prevState) animateElement(bfigEl, 'num-bump');
      }
      if (!prevState || prevState.bov !== state.bov) {
        bovEl.textContent = state.bov;
        if (prevState) animateElement(bovEl, 'num-bump');
      }

      // Optional Over Ball Dots
      const ballsWrap = document.getElementById('dispOverBalls');
      if (state.showBalls && Array.isArray(state.balls) && state.balls.length > 0) {
        ballsWrap.classList.remove('hidden');
        ballsWrap.innerHTML = state.balls.slice(-6).map(b => {
          const up = String(b).toUpperCase();
          let cls = 'ball-dot';
          if (up === '4' || up === '6') cls += ' boundary';
          else if (up === 'W') cls += ' wicket';
          return `<span class="${cls}">${b}</span>`;
        }).join('');
      } else {
        ballsWrap.classList.add('hidden');
      }

      if (!prevState || prevState.bat !== state.bat || prevState.bowl !== state.bowl || prevState.leftLogo !== state.leftLogo || prevState.rightLogo !== state.rightLogo) {
        renderCrests();
      }
    }

    /**
     * Public API: window.updateScoreboard(data)
     * Accepts partial or full scoreboard updates from OBS scripts, vMix, or postMessage
     */
    window.updateScoreboard = function (data) {
      if (!data || typeof data !== 'object') return;
      const prevState = { ...state };
      state = { ...state, ...data };
      if (typeof state.bat === 'string') state.bat = state.bat.toUpperCase();
      if (typeof state.bowl === 'string') state.bowl = state.bowl.toUpperCase();
      if (typeof state.p1 === 'string') state.p1 = state.p1.toUpperCase();
      if (typeof state.p2 === 'string') state.p2 = state.p2.toUpperCase();
      if (typeof state.bowler === 'string') state.bowler = state.bowler.toUpperCase();
      renderScoreboard(prevState);
    };

    /**
     * Public API: window.triggerEvent(type, customCaption)
     * Supported types: 'FOUR', 'SIX', 'WICKET', 'FREEHIT', 'CHASED'
     */
    window.triggerEvent = function (type, customCaption) {
      const banner = document.getElementById('eventBanner');
      const badge = document.getElementById('eventBadge');
      const headline = document.getElementById('eventHeadline');
      const caption = document.getElementById('eventCaption');

      const normalized = String(type || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      const strikerName = state.striker === 1 ? state.p1 : state.p2;

      const presets = {
        FOUR: {
          theme: 'theme-four',
          badge: state.bat,
          headline: 'FOUR!',
          caption: customCaption || `${strikerName} • CRACKING BOUNDARY`
        },
        '4': {
          theme: 'theme-four',
          badge: state.bat,
          headline: 'FOUR!',
          caption: customCaption || `${strikerName} • CRACKING BOUNDARY`
        },
        SIX: {
          theme: 'theme-six',
          badge: state.bat,
          headline: 'MAXIMUM SIX!',
          caption: customCaption || `${strikerName} • OUT OF THE PARK`
        },
        '6': {
          theme: 'theme-six',
          badge: state.bat,
          headline: 'MAXIMUM SIX!',
          caption: customCaption || `${strikerName} • OUT OF THE PARK`
        },
        WICKET: {
          theme: 'theme-wicket',
          badge: state.bowl,
          headline: 'WICKET! OUT!',
          caption: customCaption || `${state.bowler} STRIKES • ${state.score}`
        },
        W: {
          theme: 'theme-wicket',
          badge: state.bowl,
          headline: 'WICKET! OUT!',
          caption: customCaption || `${state.bowler} STRIKES • ${state.score}`
        },
        FREEHIT: {
          theme: 'theme-freehit',
          badge: 'NO BALL',
          headline: 'FREE HIT!',
          caption: customCaption || `${strikerName} ON STRIKE`
        },
        CHASED: {
          theme: 'theme-chased',
          badge: `${state.bat} WIN`,
          headline: 'TARGET CHASED!',
          caption: customCaption || `${state.bat} DEFEAT ${state.bowl}`
        }
      };

      const cfg = presets[normalized];
      if (!cfg) return;

      if (eventTimer) clearTimeout(eventTimer);

      banner.className = `event-banner-overlay ${cfg.theme}`;
      badge.textContent = cfg.badge;
      headline.textContent = cfg.headline;
      caption.textContent = cfg.caption;

      // Re-trigger zoom animation on headline
      animateElement(headline, 'event-main-headline');

      requestAnimationFrame(() => {
        banner.classList.add('active');
      });

      eventTimer = setTimeout(() => {
        banner.classList.remove('active');
      }, 3200);
    };

    // Helper for silent quick-scoring hotkeys
    function incrementOvers(ovStr) {
      const parts = String(ovStr).split('.');
      let whole = parseInt(parts[0] || '0', 10) || 0;
      let balls = parseInt(parts[1] || '0', 10) || 0;
      balls += 1;
      if (balls >= 6) {
        whole += 1;
        balls = 0;
      }
      return `${whole}.${balls}`;
    }

    function applyQuickBall(runs, isWicket = false) {
      const prevState = { ...state };
      const [curRunsStr, curWktsStr] = String(state.score).split('-');
      const curRuns = (parseInt(curRunsStr, 10) || 0) + runs;
      const curWkts = Math.min(10, (parseInt(curWktsStr, 10) || 0) + (isWicket ? 1 : 0));
      state.score = `${curRuns}-${curWkts}`;
      state.overs = incrementOvers(state.overs);

      const [bWktsStr, bRunsStr] = String(state.bfig).split('-');
      const bWkts = (parseInt(bWktsStr, 10) || 0) + (isWicket ? 1 : 0);
      const bRuns = (parseInt(bRunsStr, 10) || 0) + runs;
      state.bfig = `${bWkts}-${bRuns}`;
      state.bov = incrementOvers(state.bov);

      if (state.striker === 1) {
        state.p1r += runs;
        state.p1b += 1;
      } else {
        state.p2r += runs;
        state.p2b += 1;
      }

      if (runs % 2 === 1) {
        state.striker = state.striker === 1 ? 2 : 1;
      }

      renderScoreboard(prevState);

      if (isWicket) window.triggerEvent('WICKET');
      else if (runs === 4) window.triggerEvent('FOUR');
      else if (runs === 6) window.triggerEvent('SIX');
    }

    // Listen to window.postMessage for external studio control panels
    window.addEventListener('message', (event) => {
      const msg = event.data;
      if (!msg || typeof msg !== 'object') return;
      if (msg.type === 'UPDATE_SCOREBOARD' && msg.payload) {
        window.updateScoreboard(msg.payload);
      } else if (msg.type === 'TRIGGER_EVENT' && msg.event) {
        window.triggerEvent(msg.event, msg.caption);
      }
    });

    // Silent Keyboard Hotkeys (when Browser Source is interacted with in OBS/vMix)
    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const key = e.key.toUpperCase();
      if (key === '0') applyQuickBall(0, false);
      else if (key === '1') applyQuickBall(1, false);
      else if (key === '2') applyQuickBall(2, false);
      else if (key === '3') applyQuickBall(3, false);
      else if (key === '4') applyQuickBall(4, false);
      else if (key === '6') applyQuickBall(6, false);
      else if (key === 'W') applyQuickBall(0, true);
      else if (key === 'F') window.triggerEvent('FREEHIT');
      else if (key === 'C') window.triggerEvent('CHASED');
      else if (key === 'S') {
        const prev = { ...state };
        state.striker = state.striker === 1 ? 2 : 1;
        renderScoreboard(prev);
      } else if (key === 'R') {
        const prev = { ...state };
        state = { ...DEFAULT_STATE, ...parseQueryParams() };
        renderScoreboard(prev);
      }
    });

    // Boot overlay immediately on load
    window.addEventListener('DOMContentLoaded', () => {
      state = { ...DEFAULT_STATE, ...parseQueryParams() };
      renderScoreboard(null);

      // Optional auto-event trigger via ?event=FOUR or ?event=SIX
      const initialEvent = new URLSearchParams(window.location.search).get('event');
      if (initialEvent) {
        setTimeout(() => window.triggerEvent(initialEvent), 950);
      }
    });
  </script>
</body>
</html>